// This is your Prisma schema file — business logic entities for KRAAK
// Payload CMS uses its own Drizzle ORM for CMS tables (opportunities, admin_users, etc.)
// Migration order: npx payload migrate THEN npx prisma migrate deploy

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  supabase_uid   String    @unique
  alerts_enabled Boolean   @default(false)
  welcome_sent   Boolean   @default(false)
  deleted_at     DateTime?
  created_at     DateTime  @default(now())

  test_responses      TestResponse[]
  purchase_accesses   PurchaseAccess[]
  payments            Payment[]
  guide_subscriptions        GuideSubscription[]
  saved_opportunities        SavedOpportunity[]
  deadline_alert_preferences DeadlineAlertPreference[]
  checkout_sessions          CheckoutSession[]
}

model TestResponse {
  id         String   @id @default(cuid())
  user_id    String
  answers    Json
  completed  Boolean  @default(false)
  created_at DateTime @default(now())

  user          User              @relation(fields: [user_id], references: [id])
  profile_score UserProfileScore?
}

model UserProfileScore {
  id               String   @id @default(cuid())
  test_response_id String   @unique
  academic_score   Int
  financial_score  Int
  maturity_score   Int
  segment          String
  computed_at      DateTime @default(now())

  test_response     TestResponse     @relation(fields: [test_response_id], references: [id])
  recommendations   Recommendation[]
  purchase_accesses PurchaseAccess[]
}

model Recommendation {
  id             String @id @default(cuid())
  score_id       String
  opportunity_id String // référence vers table Payload CMS (opportunities)
  match_score    Float
  justification  String

  profile_score UserProfileScore @relation(fields: [score_id], references: [id])
}

model Payment {
  id                 String        @id @default(cuid())
  user_id            String
  amount             Int // en XOF entier — jamais Float pour des montants financiers
  currency           String        @default("XOF")
  psp                String // "cinetpay" | "notchpay"
  psp_transaction_id String?       @unique
  status             PaymentStatus @default(PENDING)
  created_at         DateTime      @default(now())
  updated_at         DateTime      @updatedAt

  user            User            @relation(fields: [user_id], references: [id])
  purchase_access PurchaseAccess?
}

model PurchaseAccess {
  id         String   @id @default(cuid())
  user_id    String
  payment_id String   @unique
  score_id   String
  expires_at DateTime // now() + 6 mois — jamais null
  created_at DateTime @default(now())

  user          User             @relation(fields: [user_id], references: [id])
  payment       Payment          @relation(fields: [payment_id], references: [id])
  profile_score UserProfileScore @relation(fields: [score_id], references: [id])
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

model CoachingBooking {
  id         String                @id @default(cuid())
  date       String                // "YYYY-MM-DD"
  slot       String                // "HH:MM"
  email      String?
  status     CoachingBookingStatus @default(PENDING)
  expires_at DateTime
  created_at DateTime              @default(now())

  @@unique([date, slot])
}

enum CoachingBookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model GuideSubscription {
  id                 String                  @id @default(cuid())
  user_id            String
  plan               GuidePlan
  status             GuideSubscriptionStatus @default(ACTIVE)
  current_period_end DateTime
  lemon_order_id     String?
  created_at         DateTime                @default(now())
  updated_at         DateTime                @updatedAt

  user User @relation(fields: [user_id], references: [id])

  @@index([user_id])
}

enum GuidePlan {
  MONTHLY
  ANNUAL
}

enum GuideSubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
}

model SavedOpportunity {
  id             String   @id @default(cuid())
  user_id        String
  opportunity_id String   // ID Payload CMS — pas de FK (ORM séparé)
  saved_at       DateTime @default(now())

  user                     User                      @relation(fields: [user_id], references: [id])
  deadline_alert_preference DeadlineAlertPreference?

  @@unique([user_id, opportunity_id])
  @@index([user_id])
}

model DeadlineAlertPreference {
  id             String   @id @default(cuid())
  user_id        String
  opportunity_id String
  alert_90d      Boolean  @default(true)
  alert_30d      Boolean  @default(true)
  alert_7d       Boolean  @default(true)
  saved_opp_id   String   @unique

  user           User              @relation(fields: [user_id], references: [id])
  saved_opp      SavedOpportunity  @relation(fields: [saved_opp_id], references: [id])
  sent_alerts    SentDeadlineAlert[]

  @@unique([user_id, opportunity_id])
  @@index([user_id])
}

model SentDeadlineAlert {
  id          String   @id @default(cuid())
  pref_id     String
  days_before Int      // 90, 30, ou 7
  sent_at     DateTime @default(now())

  preference  DeadlineAlertPreference @relation(fields: [pref_id], references: [id])

  @@unique([pref_id, days_before])
}

model CheckoutSession {
  id         String         @id @default(cuid())
  user_id    String
  plan       GuidePlan
  token      String         @unique @default(uuid())
  status     CheckoutStatus @default(PENDING)
  expires_at DateTime
  created_at DateTime       @default(now())

  user       User           @relation(fields: [user_id], references: [id])

  @@index([user_id])
  @@index([token])
}

enum CheckoutStatus {
  PENDING
  COMPLETED
  EXPIRED
}

model WaitlistEntry {
  id               String   @id @default(cuid())
  email            String   @unique
  source           String   @default("landing")
  first_name       String?
  country          String?
  education_level  String?
  domain           String?
  opportunity_type String?
  interest         String?
  pain_point       String?
  status           String   @default("pending")
  created_at       DateTime @default(now())
}
