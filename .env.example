# =============================================================================
# KRAAK — Variables d'environnement
# Copier ce fichier en .env.local pour le développement
# Ne jamais commiter .env.local ou tout fichier contenant de vraies valeurs
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase
# https://supabase.com/dashboard/project/_/settings/api
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # Côté serveur uniquement — jamais exposé au client

# -----------------------------------------------------------------------------
# Base de données — Prisma
# Utiliser l'URL avec pooler (port 6543) en production/staging
# Utiliser l'URL directe (port 5432) pour les migrations
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.xxxxxxxxxxxxxxxxxxxx.supabase.co:5432/postgres

# -----------------------------------------------------------------------------
# Payload CMS
# Chaîne aléatoire longue (min. 32 caractères) pour signer les sessions admin
# Générer avec : openssl rand -base64 32
# -----------------------------------------------------------------------------
PAYLOAD_SECRET=

# -----------------------------------------------------------------------------
# CinetPay — Paiement Mobile Money (Orange Money, MTN MoMo, Moov, Wave)
# https://dashboard.cinetpay.com
# -----------------------------------------------------------------------------
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_WEBHOOK_SECRET=          # Pour vérifier la signature HMAC des webhooks

# -----------------------------------------------------------------------------
# Upstash Redis — Rate limiting (auth + paiement)
# https://console.upstash.com
# -----------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# -----------------------------------------------------------------------------
# PostHog — Analytics produit
# https://app.posthog.com/project/settings
# -----------------------------------------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# -----------------------------------------------------------------------------
# Sentry — Error tracking
# https://sentry.io/settings/[org]/projects/[project]/keys/
# -----------------------------------------------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# -----------------------------------------------------------------------------
# Resend — Emails transactionnels (confirmation paiement, révocation accès)
# https://resend.com/api-keys
# -----------------------------------------------------------------------------
RESEND_API_KEY=

# -----------------------------------------------------------------------------
# Chariow — Paiement Guide Premium & Coaching
# Récupérer les URLs depuis ton dashboard Chariow (page produit de chaque offre)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CHARIOW_GUIDE_MONTHLY_URL=       # URL page produit Guide mensuel
NEXT_PUBLIC_CHARIOW_GUIDE_ANNUAL_URL=        # URL page produit Guide annuel
NEXT_PUBLIC_CHARIOW_COACHING_AUDIT_URL=      # URL page produit Coaching audit (15 000 XOF)
NEXT_PUBLIC_CHARIOW_COACHING_ACCOMPAGNEMENT_URL=  # URL page produit Coaching complet (50 000 XOF)
CHARIOW_WEBHOOK_SECRET=                      # Secret HMAC pour validation des webhooks (Phase 3)
CHARIOW_PRODUCT_GUIDE_MONTHLY_ID=            # ID produit Chariow Guide mensuel (Phase 3)
CHARIOW_PRODUCT_GUIDE_ANNUAL_ID=             # ID produit Chariow Guide annuel (Phase 3)

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://kraak.co         # URL publique (sans slash final)
CRON_SECRET=                                 # Secret partagé pour sécuriser les endpoints cron

# -----------------------------------------------------------------------------
# Environnement
# Valeurs possibles : development | staging | production
# -----------------------------------------------------------------------------
NODE_ENV=development
